# AgriGuide Cloud Production Environment Configuration

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings > Environment Variables)
# ==============================================================================
# Set this to the public URL of your deployed backend service:
VITE_API_URL=https://agriguide-backend.onrender.com/api


# ==============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Set in Render / Railway / Fly.io / Cloud Run)
# ==============================================================================
ENVIRONMENT=production
SECRET_KEY=replace-with-a-random-32-byte-hex-string-for-security
CORS_ORIGINS=*

# SingularityNET / ASI Cloud Neural Perception (Optional but recommended)
ASI_CLOUD_KEY=your_asi_cloud_or_openrouter_api_key_here
ASI_CLOUD_URL=https://llm.c.singularitynet.io/v1
ASI_CLOUD_MODEL=minimax/minimax-m3

# Database (Defaults to SQLite; supports PostgreSQL on Render/Neon/Supabase)
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/agriguide?sslmode=require
DATABASE_URL=sqlite:////app/agriguide.db
