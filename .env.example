DATABASE_URL=sqlite:///./agriguide.db
CORS_ORIGINS=http://localhost:5173
WEATHER_PROVIDER=mock
LLM_PROVIDER=asi
OMEGA_MODE=local
# For a separately running Omega gateway:
# OMEGA_MODE=external
# OMEGA_URL=http://localhost:18789/agriguide/cognitive
METTA_BINARY=metta

# --- SingularityNET / ASI Cloud OpenAI-compatible LLM Configuration ---
# Dedicated API key received from The Basix Team for the Basix Hackathon
ASI_CLOUD_KEY=your_basix_hackathon_api_key_here
ASI_CLOUD_URL=https://llm.c.singularitynet.io/v1
# Default recommended model for agentic tool use and reasoning: minimax/minimax-m3
# Alternate available models: asi1-mini, google/gemma-3-27b-it, meta-llama/llama-3.3-70b-instruct, qwen/qwen3-32b
ASI_CLOUD_MODEL=minimax/minimax-m3

